{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@services/*": [
        "../services/dist/*"
      ],
      "@adapters/*": [
        "./src/*"
      ],
      "@shelfline/core": [
        "../../packages/core/dist/index.d.ts"
      ],
      "@shelfline/core/*": [
        "../../packages/core/dist/*"
      ],
      "@shelfline/services": [
        "../services/dist/index.d.ts"
      ],
      "@shelfline/services/*": [
        "../services/dist/*"
      ]
    },
    "module": "ESNext"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
